{
  "datasets": [
    {
      "name": "health",
      "displayName": "Issues, last 14 days",
      "queryLines": [
        "SELECT date_format(from_utc_timestamp(at, 'Asia/Singapore'), 'dd MMM HH:mm') AS at_sgt, source, name, status, detail FROM ( SELECT ended_at AS at, 'job run' AS source, job_name AS name, result_state AS status, termination_code AS detail FROM meridian.obs.v_job_runs WHERE ended_at >= current_timestamp() - INTERVAL 14 DAYS AND result_state <> 'SUCCEEDED' UNION ALL SELECT ended_at, 'task run', concat(job_name, '.', task_key), result_state, termination_code FROM meridian.obs.v_task_runs WHERE ended_at >= current_timestamp() - INTERVAL 14 DAYS AND result_state NOT IN ('SUCCEEDED', 'EXCLUDED', 'SKIPPED') UNION ALL SELECT timestamp, 'pipeline', coalesce(flow_name, 'update'), level, coalesce(error_message, message) FROM meridian.obs.v_pipeline_events WHERE timestamp >= current_timestamp() - INTERVAL 14 DAYS AND level IN ('ERROR', 'WARN') UNION ALL SELECT checked_at, concat('check: ', check_name), concat_ws('.', table_name, column_name), 'BREACH', message FROM (SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian.obs.drift_events UNION ALL SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian.obs.freshness_events UNION ALL SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian.gov.pii_coverage) WHERE breached AND checked_at >= current_timestamp() - INTERVAL 14 DAYS UNION ALL SELECT max(_quarantined_at), 'quarantine', rule, 'QUARANTINED', concat(count(*), ' payment rows') FROM meridian.quarantine.payments LATERAL VIEW explode(_failed_rules) r AS rule WHERE _quarantined_at >= current_timestamp() - INTERVAL 14 DAYS AND reprocessed_at IS NULL GROUP BY rule ) ORDER BY at DESC"
      ]
    },
    {
      "name": "acquirers",
      "displayName": "Acquirer status",
      "queryLines": [
        "SELECT acquirer_id, status, round(100 * recent_failure_rate, 1) AS recent_failure_pct, round(100 * baseline_failure_rate, 1) AS baseline_failure_pct FROM meridian.gold.acquirer_status ORDER BY status = 'degraded' DESC, recent_failure_rate DESC"
      ]
    },
    {
      "name": "markets",
      "displayName": "Payments by market (your row filter applies)",
      "queryLines": [
        "SELECT country, count(*) AS payments FROM meridian.silver.payments GROUP BY country ORDER BY payments DESC"
      ]
    },
    {
      "name": "kb_status",
      "displayName": "Knowledge sync",
      "queryLines": [
        "SELECT last_run_at, live_docs_general, live_docs_finance, chunks_general, chunks_finance, failures_24h FROM meridian.kb.sync_status"
      ]
    },
    {
      "name": "kb_changes",
      "displayName": "Knowledge changes",
      "queryLines": [
        "SELECT doc_id, source, tier, source_version, last_editor, date_format(from_utc_timestamp(edited_at, 'Asia/Singapore'), 'dd MMM HH:mm') AS edited_sgt, change FROM meridian.obs.v_kb_changes WHERE deleted_at IS NULL ORDER BY edited_at DESC"
      ]
    },
    {
      "name": "runs_by_user",
      "displayName": "Copilot runs by caller",
      "queryLines": [
        "WITH roles AS (SELECT principal, 'Eli (admin)' AS caller, 0 AS rank FROM meridian.agent.approvers UNION ALL SELECT principal, 'Ben (finance)', 1 FROM meridian.agent.tier_members WHERE tier = 'finance' UNION ALL SELECT principal, 'Ava (support)', 2 FROM meridian.agent.tier_members WHERE tier = 'general'), callers AS (SELECT principal, min_by(caller, rank) AS caller FROM roles GROUP BY principal) SELECT coalesce(c.caller, 'other') AS caller, count(*) AS runs, round(avg(r.duration_ms) / 1000, 1) AS avg_seconds, sum(r.input_tokens) AS input_tokens, sum(r.cache_read_tokens) AS cache_read_tokens FROM meridian.agent.v_copilot_runs r LEFT JOIN callers c ON c.principal = r.principal GROUP BY 1 ORDER BY runs DESC"
      ]
    },
    {
      "name": "denials",
      "displayName": "Refusals and denials",
      "queryLines": [
        "WITH roles AS (SELECT principal, 'Eli (admin)' AS caller, 0 AS rank FROM meridian.agent.approvers UNION ALL SELECT principal, 'Ben (finance)', 1 FROM meridian.agent.tier_members WHERE tier = 'finance' UNION ALL SELECT principal, 'Ava (support)', 2 FROM meridian.agent.tier_members WHERE tier = 'general'), callers AS (SELECT principal, min_by(caller, rank) AS caller FROM roles GROUP BY principal) SELECT date_format(from_utc_timestamp(d.at, 'Asia/Singapore'), 'dd MMM HH:mm') AS at_sgt, coalesce(c.caller, 'other') AS caller, d.kind, d.what, d.detail FROM meridian.agent.v_copilot_denials d LEFT JOIN callers c ON c.principal = d.principal ORDER BY d.at DESC"
      ]
    },
    {
      "name": "latency",
      "displayName": "Tool latency",
      "queryLines": [
        "SELECT tool, calls, errors, p50_ms, p95_ms, max_ms FROM meridian.agent.v_copilot_tool_latency ORDER BY p95_ms DESC"
      ]
    },
    {
      "name": "cache",
      "displayName": "Prompt cache",
      "queryLines": [
        "SELECT sum(input_tokens) AS uncached_input, sum(cache_read_tokens) AS cache_read, sum(cache_write_tokens) AS cache_write FROM meridian.agent.v_copilot_runs"
      ]
    },
    {
      "name": "scorecard",
      "displayName": "POC scorecard",
      "queryLines": [
        "SELECT req_id, requirement, tasks, status, headline, evidence FROM meridian.obs.evidence ORDER BY req_id"
      ]
    },
    {
      "name": "score_counts",
      "displayName": "Scorecard counts",
      "queryLines": [
        "SELECT count_if(status = 'PASS') AS pass, count_if(status = 'PARTIAL') AS partial, count_if(status NOT IN ('PASS', 'PARTIAL')) AS other, count(*) AS requirements FROM meridian.obs.evidence"
      ]
    }
  ],
