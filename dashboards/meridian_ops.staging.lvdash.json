{
  "datasets": [
    {
      "name": "health",
      "displayName": "Pipeline health, last 24h",
      "queryLines": [
        "SELECT at, source, name, status, detail FROM meridian_staging.obs.v_pipeline_health ORDER BY at DESC"
      ]
    },
    {
      "name": "acquirers",
      "displayName": "Acquirer status",
      "queryLines": [
        "SELECT acquirer_id, status, round(100 * recent_failure_rate, 1) AS recent_failure_pct, round(100 * baseline_failure_rate, 1) AS baseline_failure_pct FROM meridian_staging.gold.acquirer_status ORDER BY acquirer_id"
      ]
    },
    {
      "name": "markets",
      "displayName": "Payments by market (your row filter applies)",
      "queryLines": [
        "SELECT country, count(*) AS payments FROM meridian_staging.silver.payments GROUP BY country ORDER BY payments DESC"
      ]
    }
  ],
