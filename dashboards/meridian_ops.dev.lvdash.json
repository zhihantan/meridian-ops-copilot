{
  "datasets": [
    {
      "name": "health",
      "displayName": "Issues, last 14 days",
      "queryLines": [
        "SELECT date_format(from_utc_timestamp(at, 'Asia/Singapore'), 'dd MMM HH:mm') AS at_sgt, source, name, status, detail FROM ( SELECT ended_at AS at, 'job run' AS source, job_name AS name, result_state AS status, termination_code AS detail FROM meridian_dev.dev_zhihan_tan_obs.v_job_runs WHERE ended_at >= current_timestamp() - INTERVAL 14 DAYS AND result_state <> 'SUCCEEDED' UNION ALL SELECT ended_at, 'task run', concat(job_name, '.', task_key), result_state, termination_code FROM meridian_dev.dev_zhihan_tan_obs.v_task_runs WHERE ended_at >= current_timestamp() - INTERVAL 14 DAYS AND result_state NOT IN ('SUCCEEDED', 'EXCLUDED', 'SKIPPED') UNION ALL SELECT timestamp, 'pipeline', coalesce(flow_name, 'update'), level, coalesce(error_message, message) FROM meridian_dev.dev_zhihan_tan_obs.v_pipeline_events WHERE timestamp >= current_timestamp() - INTERVAL 14 DAYS AND level IN ('ERROR', 'WARN') UNION ALL SELECT checked_at, concat('check: ', check_name), concat_ws('.', table_name, column_name), 'BREACH', message FROM (SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian_dev.dev_zhihan_tan_obs.drift_events UNION ALL SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian_dev.dev_zhihan_tan_obs.freshness_events UNION ALL SELECT check_name, checked_at, table_name, column_name, message, breached FROM meridian_dev.dev_zhihan_tan_gov.pii_coverage) WHERE breached AND checked_at >= current_timestamp() - INTERVAL 14 DAYS UNION ALL SELECT max(_quarantined_at), 'quarantine', rule, 'QUARANTINED', concat(count(*), ' payment rows') FROM meridian_dev.dev_zhihan_tan_quarantine.payments LATERAL VIEW explode(_failed_rules) r AS rule WHERE _quarantined_at >= current_timestamp() - INTERVAL 14 DAYS AND reprocessed_at IS NULL GROUP BY rule ) ORDER BY at DESC"
      ]
    },
    {
      "name": "acquirers",
      "displayName": "Acquirer status",
      "queryLines": [
        "SELECT acquirer_id, status, round(100 * recent_failure_rate, 1) AS recent_failure_pct, round(100 * baseline_failure_rate, 1) AS baseline_failure_pct FROM meridian_dev.dev_zhihan_tan_gold.acquirer_status ORDER BY status = 'degraded' DESC, recent_failure_rate DESC"
      ]
    },
    {
      "name": "markets",
      "displayName": "Payments by market (your row filter applies)",
      "queryLines": [
        "SELECT country, count(*) AS payments FROM meridian_dev.dev_zhihan_tan_silver.payments GROUP BY country ORDER BY payments DESC"
      ]
    },
    {
      "name": "kb_status",
      "displayName": "Knowledge sync",
      "queryLines": [
        "SELECT last_run_at, live_docs_general, live_docs_finance, chunks_general, chunks_finance, failures_24h FROM meridian_dev.dev_zhihan_tan_kb.sync_status"
      ]
    },
    {
      "name": "kb_changes",
      "displayName": "Knowledge changes",
      "queryLines": [
        "SELECT doc_id, source, tier, source_version, last_editor, date_format(from_utc_timestamp(edited_at, 'Asia/Singapore'), 'dd MMM HH:mm') AS edited_sgt, change FROM meridian_dev.dev_zhihan_tan_obs.v_kb_changes WHERE deleted_at IS NULL ORDER BY edited_at DESC"
      ]
    }
  ],
