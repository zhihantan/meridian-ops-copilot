{
  "datasets": [
    {
      "name": "health",
      "displayName": "Pipeline health, last 24h",
      "queryLines": [
        "SELECT at, source, name, status, detail FROM meridian_dev.dev_zhihan_tan_obs.v_pipeline_health ORDER BY at DESC"
      ]
    },
    {
      "name": "acquirers",
      "displayName": "Acquirer status",
      "queryLines": [
        "SELECT acquirer_id, status, round(100 * recent_failure_rate, 1) AS recent_failure_pct, round(100 * baseline_failure_rate, 1) AS baseline_failure_pct FROM meridian_dev.dev_zhihan_tan_gold.acquirer_status ORDER BY acquirer_id"
      ]
    },
    {
      "name": "markets",
      "displayName": "Payments by market (your row filter applies)",
      "queryLines": [
        "SELECT country, count(*) AS payments FROM meridian_dev.dev_zhihan_tan_silver.payments GROUP BY country ORDER BY payments DESC"
      ]
    },
    {
      "name": "kb_status",
      "displayName": "Knowledge sync",
      "queryLines": [
        "SELECT last_run_at, live_docs_general, live_docs_finance, chunks_general, chunks_finance, failures_24h FROM meridian_dev.dev_zhihan_tan_kb.sync_status"
      ]
    },
    {
      "name": "kb_changes",
      "displayName": "Knowledge changes",
      "queryLines": [
        "SELECT doc_id, source, tier, source_version, last_editor, edited_at, change FROM meridian_dev.dev_zhihan_tan_obs.v_kb_changes WHERE deleted_at IS NULL ORDER BY edited_at DESC"
      ]
    }
  ],
